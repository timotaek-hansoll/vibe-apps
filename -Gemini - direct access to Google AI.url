import React, { useState, useEffect, useRef } from 'react';
import { 
  BarChart3, 
  Settings, 
  Users, 
  Plus, 
  Trash2, 
  Home, 
  Target, 
  ShieldCheck, 
  TrendingUp, 
  Edit2, 
  Save, 
  Download, 
  Upload, 
  Copy, 
  History,
  CheckCircle2,
  AlertCircle,
  ChevronRight,
  UserCircle,
  BookOpen,
  X,
  Zap,
  Globe,
  Clock,
  LayoutGrid
} from 'lucide-react';

const INITIAL_Y_CRITERIA = [
  { id: 'y1', name: 'Revenue Scale & Strategic Weight', weight: 15 },
  { id: 'y2', name: 'Growth Opportunity', weight: 25 },
  { id: 'y3', name: 'Financial Health (Payment)', weight: 25 },
  { id: 'y4', name: 'Strategic Alignment (ESG)', weight: 15 },
  { id: 'y5', name: 'Future Proof / Innovation', weight: 20 },
];

const INITIAL_X_CRITERIA = [
  { id: 'x1', name: 'Operating Margin %', weight: 25 },
  { id: 'x2', name: 'OQL & Exceptions', weight: 20 },
  { id: 'x3', name: 'Efficiency / VPMH', weight: 20 },
  { id: 'x4', name: 'Average Lead Time', weight: 15 },
  { id: 'x5', name: 'Capacity Utilization', weight: 20 },
];

const INITIAL_CUSTOMERS = [
  { 
    id: 'bd3-1', 
    name: 'Strategic Global Client A', 
    revenue: 95, 
    yScores: { y1: 5, y2: 4, y3: 4, y4: 5, y5: 4 },
    xScores: { x1: 4, x2: 4, x3: 3, x4: 3, x5: 4 }
  },
  { 
    id: 'bd3-2', 
    name: 'Emerging Tech Partner', 
    revenue: 30, 
    yScores: { y1: 2, y2: 5, y3: 3, y4: 4, y5: 5 },
    xScores: { x1: 5, x2: 2, x3: 4, x4: 4, x5: 2 }
  },
  { 
    id: 'bd3-3', 
    name: 'Value Volume Retailer', 
    revenue: 110, 
    yScores: { y1: 5, y2: 3, y3: 2, y4: 2, y5: 2 },
    xScores: { x1: 2, x2: 3, x3: 5, x4: 5, x5: 5 }
  }
];

export default function App() {
  const [activeTab, setActiveTab] = useState('home');
  const [customers, setCustomers] = useState(INITIAL_CUSTOMERS);
  const [yCriteria, setYCriteria] = useState(INITIAL_Y_CRITERIA);
  const [xCriteria, setXCriteria] = useState(INITIAL_X_CRITERIA);
  const [editingId, setEditingId] = useState(null);
  const [showCheatSheet, setShowCheatSheet] = useState(false);
  
  const [savedSimulations, setSavedSimulations] = useState([]);
  const [currentSimName, setCurrentSimName] = useState('BD3 Q1 Baseline');
  const [toast, setToast] = useState(null);
  const fileInputRef = useRef(null);

  useEffect(() => {
    const saved = localStorage.getItem('hansoll_bd3_sims');
    if (saved) setSavedSimulations(JSON.parse(saved));
  }, []);

  useEffect(() => {
    localStorage.setItem('hansoll_bd3_sims', JSON.stringify(savedSimulations));
  }, [savedSimulations]);

  const showToast = (message, type = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3000);
  };

  const calculatePosition = (customer) => {
    const yTotal = yCriteria.reduce((sum, c) => sum + ((customer.yScores[c.id] || 3) * (c.weight / 100)), 0);
    const xTotal = xCriteria.reduce((sum, c) => sum + ((customer.xScores[c.id] || 3) * (c.weight / 100)), 0);
    return { x: xTotal, y: yTotal };
  };

  const getAction = (x, y) => {
    const threshold = 3.0;
    if (y >= threshold && x >= threshold) return { label: 'INVEST', color: 'bg-indigo-600', ring: 'ring-indigo-200' };
    if (y >= threshold && x < threshold) return { label: 'PROTECT / FIX', color: 'bg-orange-500', ring: 'ring-orange-200' };
    if (y < threshold && x >= threshold) return { label: 'HARVEST', color: 'bg-emerald-600', ring: 'ring-emerald-200' };
    return { label: 'EXIT', color: 'bg-rose-600', ring: 'ring-rose-200' };
  };

  const handleSaveSimulation = () => {
    const newSim = {
      id: Date.now(),
      name: currentSimName || `BD3 Sim ${new Date().toLocaleTimeString()}`,
      timestamp: new Date().toLocaleString(),
      data: { customers, yCriteria, xCriteria }
    };
    setSavedSimulations([newSim, ...savedSimulations]);
    showToast("BD3 Simulation saved");
  };

  const handleImportClick = () => fileInputRef.current?.click();

  const handleFileImport = (event) => {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const importedData = JSON.parse(e.target.result);
        if (Array.isArray(importedData)) {
          setSavedSimulations(prev => [...importedData, ...prev]);
          showToast(`Imported ${importedData.length} BD3 scenarios`);
        }
      } catch (err) {
        showToast("Invalid JSON format", "error");
      }
    };
    reader.readAsText(file);
    event.target.value = '';
  };

  const totalRev = customers.reduce((s, c) => s + (Number(c.revenue) || 0), 0);

  const handleRevenueChange = (id, value) => {
    const newCustomers = customers.map(c => {
      if (c.id === id) {
        return { ...c, revenue: value === '' ? '' : Number(value) };
      }
      return c;
    });
    setCustomers(newCustomers);
  };

  const CheatSheet = () => (
    <div className={`fixed inset-y-0 right-0 w-full sm:w-[500px] bg-white shadow-2xl z-[1000] transform transition-transform duration-300 ease-in-out flex flex-col ${showCheatSheet ? 'translate-x-0' : 'translate-x-full'}`}>
      <div className="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-900 text-white">
        <div>
          <h2 className="text-xl font-bold tracking-tight">Scoring Cheat Sheet</h2>
          <p className="text-xs text-slate-400 uppercase tracking-widest mt-1">Rolling 12-Month Logic Standards</p>
        </div>
        <button onClick={() => setShowCheatSheet(false)} className="p-2 hover:bg-white/10 rounded-full transition">
          <X size={24} />
        </button>
      </div>
      <div className="flex-1 overflow-y-auto p-6 space-y-8 pb-12">
        <section>
          <h3 className="text-sm font-black text-indigo-600 uppercase mb-4 flex items-center gap-2">
            <TrendingUp size={16} /> Customer Attractiveness (Y-Axis)
          </h3>
          <div className="space-y-4">
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><Users size={12}/> Revenue Scale (15%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: ≥ $30M</span> <span className="text-slate-400">4: $15M-$29.9M</span></div>
                <div className="flex justify-between"><span>3: $5M-$14.9M</span> <span className="text-slate-400">2: $2M-$4.9M</span></div>
                <div className="text-rose-500 font-bold">1: &lt; $2M</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><TrendingUp size={12}/> Growth CAGR (25%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: ≥ 15%</span> <span className="text-slate-400">4: 8%-14.9%</span></div>
                <div className="flex justify-between"><span>3: 0%-7.9%</span> <span className="text-slate-400">2: -5% to -0.1%</span></div>
                <div className="text-rose-500 font-bold">1: &lt; -5%</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl border-l-4 border-rose-400">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><ShieldCheck size={12}/> Financial Health (25%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: ≤ 30 days (DSO ≤ 35)</span> <span className="text-slate-400">4: 31-45 days</span></div>
                <div className="flex justify-between"><span>3: 46-60 days</span> <span className="text-slate-400">2: 61-75 days</span></div>
                <div className="text-rose-600 font-black">Rule: Score 1-2 → No INVEST</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><Globe size={12}/> Strategic Alignment / ESG (15%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: Lead Tier / Top ESG Score</span> <span className="text-slate-400">4: Active ESG Collab</span></div>
                <div className="flex justify-between"><span>3: Compliant / Standard</span> <span className="text-slate-400">2: Low ESG transparency</span></div>
                <div className="text-rose-500 font-bold">1: Critical Risk / Alignment Gap</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><Zap size={12}/> Future Proof / Innovation (20%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: Co-development Partner</span> <span className="text-slate-400">4: Early Tech Adopter</span></div>
                <div className="flex justify-between"><span>3: Standard R&D Needs</span> <span className="text-slate-400">2: Slow to Innovate</span></div>
                <div className="text-rose-500 font-bold">1: Obsolescence Risk</div>
              </div>
            </div>
          </div>
        </section>

        <section>
          <h3 className="text-sm font-black text-emerald-600 uppercase mb-4 flex items-center gap-2">
            <ShieldCheck size={16} /> Competitive Strength (X-Axis)
          </h3>
          <div className="space-y-4">
            <div className="bg-slate-50 p-4 rounded-xl border-l-4 border-rose-400">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><Target size={12}/> Operating Margin % (25%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: ≥ +4 pts vs target</span> <span className="text-slate-400">4: 0 to +3.9 pts</span></div>
                <div className="flex justify-between"><span>3: 0 to -2 pts</span> <span className="text-slate-400">2: -2.1 to -5 pts</span></div>
                <div className="text-rose-600 font-black">Rule: Score 1 → No PROTECT</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><CheckCircle2 size={12}/> OQL & Exceptions (20%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: OQL ≥ 99.5%</span> <span className="text-slate-400">4: 99.0% - 99.4%</span></div>
                <div className="flex justify-between"><span>3: 98.0% - 98.9%</span> <span className="text-slate-400">2: 96.5% - 97.9%</span></div>
                <div className="text-rose-500 font-bold">1: &lt; 96.5%</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><TrendingUp size={12}/> Efficiency / VPMH (20%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: ≥ +15% vs Avg</span> <span className="text-slate-400">4: +5% to +14.9%</span></div>
                <div className="flex justify-between"><span>3: ±4.9%</span> <span className="text-slate-400">2: -5% to -14.9%</span></div>
                <div className="text-rose-500 font-bold">1: &lt; -15%</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><Clock size={12}/> Average Lead Time (15%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: &lt; 45 Days</span> <span className="text-slate-400">4: 45 - 60 Days</span></div>
                <div className="flex justify-between"><span>3: 61 - 80 Days</span> <span className="text-slate-400">2: 81 - 100 Days</span></div>
                <div className="text-rose-500 font-bold">1: &gt; 100 Days</div>
              </div>
            </div>
            <div className="bg-slate-50 p-4 rounded-xl">
              <p className="text-xs font-bold text-slate-500 mb-2 flex items-center gap-1"><LayoutGrid size={12}/> Capacity Utilization (20%)</p>
              <div className="text-[11px] space-y-1">
                <div className="flex justify-between"><span>5: 85% - 92% (Ideal)</span> <span className="text-slate-400">4: 75% - 84%</span></div>
                <div className="flex justify-between"><span>3: 65% - 74%</span> <span className="text-slate-400">2: 50% - 64%</span></div>
                <div className="text-rose-500 font-bold">1: &lt; 50% (Underutilized)</div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  );

  return (
    <div className="flex h-screen bg-slate-50 font-sans text-slate-900 overflow-hidden relative">
      <CheatSheet />
      {showCheatSheet && <div onClick={() => setShowCheatSheet(false)} className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[999] animate-in fade-in duration-300"></div>}
      
      {toast && (
        <div className={`fixed top-6 right-6 z-[999] px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 animate-in slide-in-from-right-10 duration-300 ${toast.type === 'success' ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-white'}`}>
          {toast.type === 'success' ? <CheckCircle2 size={18}/> : <AlertCircle size={18}/>}
          <span className="text-sm font-bold">{toast.message}</span>
        </div>
      )}
      
      <nav className="h-full w-20 md:w-64 bg-slate-900 text-slate-400 flex flex-col border-r border-slate-800 transition-all flex-shrink-0">
        <div className="p-4 md:p-6 flex items-center gap-3 border-b border-slate-800">
          <div className="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-bold text-xl flex-shrink-0">3</div>
          <div className="hidden md:block overflow-hidden">
            <span className="text-white font-bold tracking-tight truncate uppercase block">Hansoll BD3</span>
            <span className="text-[10px] text-slate-500 font-medium block">BUSINESS DIVISION 3</span>
          </div>
        </div>
        
        <div className="flex-1 py-8 space-y-2 px-3">
          {[
            { id: 'home', label: 'Division Home', icon: <Home size={20}/> },
            { id: 'matrix', label: 'BD3 Matrix', icon: <BarChart3 size={20}/> },
            { id: 'customers', label: 'Portfolio', icon: <Users size={20}/> },
            { id: 'config', label: 'Scoring Logic', icon: <Settings size={20}/> },
          ].map(item => (
            <button
              key={item.id}
              onClick={() => setActiveTab(item.id)}
              className={`w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all ${
                activeTab === item.id ? 'bg-indigo-600 text-white shadow-lg' : 'hover:bg-white/5 hover:text-slate-100'
              }`}
            >
              {item.icon}
              <span className="hidden md:block font-medium">{item.label}</span>
            </button>
          ))}
        </div>

        <div className="p-4 md:p-6 border-t border-slate-800 flex items-center gap-3">
          <div className="w-8 h-8 rounded-full bg-indigo-500/20 border border-indigo-500/50 flex items-center justify-center text-[10px] text-indigo-400 font-bold">TL</div>
          <div className="hidden md:block overflow-hidden">
            <div className="text-xs text-slate-100 font-bold truncate">Tim Lee</div>
            <div className="text-[10px] text-slate-500 uppercase truncate">VP / Head of BD3</div>
          </div>
        </div>
      </nav>

      <main className="flex-1 h-full overflow-y-auto p-4 md:p-8 lg:p-12">
        <div className="max-w-7xl mx-auto">
          {activeTab === 'home' && (
            <div className="space-y-8 max-w-4xl mx-auto">
              <div className="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 text-white p-8 md:p-12 rounded-3xl shadow-2xl relative overflow-hidden">
                <div className="relative z-10">
                  <div className="inline-block px-3 py-1 bg-indigo-500/20 border border-indigo-500/30 rounded-full text-[10px] font-bold tracking-widest mb-4">DIVISION 3 STRATEGY</div>
                  <h1 className="text-3xl md:text-5xl font-extrabold mb-4 tracking-tight">Relentless Curiosity</h1>
                  <p className="text-lg md:text-xl text-slate-300 max-w-2xl leading-relaxed">
                    Harnessing relentless curiosity to evaluate BD3's portfolio and drive innovative growth within Hansoll Textile.
                  </p>
                  <div className="mt-8 flex flex-wrap gap-4">
                    <button onClick={() => setActiveTab('matrix')} className="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 rounded-full font-bold transition flex items-center gap-2">
                      Start BD3 Simulation <ChevronRight size={18}/>
                    </button>
                  </div>
                </div>
                <div className="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl"></div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                {[
                  { title: 'BD3 Decision Logic', desc: 'Standardized framework for Business Division 3 capital allocation.', icon: <Target className="text-indigo-400" /> },
                  { title: 'The Future Makers', desc: 'Leading the charge in new business development and account expansion.', icon: <TrendingUp className="text-emerald-400" /> },
                  { title: 'Knowledge Utility', desc: 'Putting skill sets to use to make others better off.', icon: <ShieldCheck className="text-indigo-300" /> },
                ].map((item, i) => (
                  <div key={i} className="p-6 bg-white border border-slate-200 rounded-2xl shadow-sm">
                    <div className="mb-4">{item.icon}</div>
                    <h3 className="text-lg font-bold mb-2">{item.title}</h3>
                    <p className="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {activeTab === 'matrix' && (
            <div className="space-y-6">
              <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm mb-8">
                <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                  <div>
                    <h3 className="text-lg font-bold flex items-center gap-2 text-slate-800">
                      <History className="text-indigo-500" size={20}/> BD3 Scenario Manager
                    </h3>
                    <p className="text-sm text-slate-500">Compare what-if scenarios for the BD3 portfolio.</p>
                  </div>
                  <div className="flex gap-2">
                    <input type="file" ref={fileInputRef} onChange={handleFileImport} accept=".json" className="hidden" />
                    <button onClick={handleImportClick} className="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold transition">
                      <Upload size={16}/> Import
                    </button>
                    <button onClick={() => {
                      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(savedSimulations, null, 2));
                      const dlNode = document.createElement('a');
                      dlNode.setAttribute("href", dataStr);
                      dlNode.setAttribute("download", "bd3_simulations.json");
                      dlNode.click();
                    }} className="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm font-bold transition">
                      <Download size={16}/> Export
                    </button>
                  </div>
                </div>
                <div className="flex gap-2 mb-6">
                  <input 
                    className="flex-1 px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" 
                    placeholder="Scenario name..." 
                    value={currentSimName} 
                    onChange={(e) => setCurrentSimName(e.target.value)} 
                  />
                  <button onClick={handleSaveSimulation} className="bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold text-sm flex items-center gap-2"><Save size={16}/> Save</button>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                  {savedSimulations.map(sim => (
                    <div key={sim.id} className="p-3 bg-slate-50 border rounded-xl flex items-center justify-between group hover:border-indigo-300">
                      <div className="overflow-hidden">
                        <div className="text-xs font-bold text-slate-800 truncate">{sim.name}</div>
                        <div className="text-[10px] text-slate-400">{sim.timestamp}</div>
                      </div>
                      <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition">
                        <button onClick={() => { setCustomers(sim.data.customers); setYCriteria(sim.data.yCriteria); setXCriteria(sim.data.xCriteria); setCurrentSimName(sim.name); }} className="p-1.5 hover:bg-indigo-100 text-indigo-600 rounded"><Copy size={14}/></button>
                        <button onClick={() => setSavedSimulations(savedSimulations.filter(s => s.id !== sim.id))} className="p-1.5 hover:bg-red-100 text-red-600 rounded"><Trash2 size={14}/></button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              
              <div className="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                <h2 className="text-2xl font-bold text-slate-800">BD3 Portfolio Matrix</h2>
                <div className="text-sm bg-indigo-50 px-4 py-2 rounded-lg border border-indigo-100">
                  Current BD3 Revenue: <span className="font-bold text-indigo-700">${totalRev}M</span>
                </div>
              </div>

              <div className="grid grid-cols-1 xl:grid-cols-4 gap-8 pb-12">
                <div className="xl:col-span-1">
                   <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                      <h3 className="font-bold text-slate-700 mb-4 border-b pb-2 text-sm uppercase tracking-wider">BD3 Decision Rules</h3>
                      <div className="space-y-4">
                        {[
                          { label: 'INVEST', color: 'bg-indigo-600', desc: 'Focus innovation & leadership' },
                          { label: 'PROTECT / FIX', color: 'bg-orange-500', desc: 'Reset terms or fix execution' },
                          { label: 'HARVEST', color: 'bg-emerald-600', desc: 'Standardize for cashflow' },
                          { label: 'EXIT', color: 'bg-rose-600', desc: 'No incremental capital' }
                        ].map((item) => (
                          <div key={item.label} className="flex items-start gap-3">
                            <div className={`w-3 h-3 mt-1 rounded-full ${item.color}`}></div>
                            <div>
                              <div className="text-xs font-bold">{item.label}</div>
                              <div className="text-[10px] text-slate-400">{item.desc}</div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                </div>
                
                <div className="xl:col-span-3 bg-white p-8 md:p-12 rounded-3xl border border-slate-200 shadow-sm relative">
                  <div className="relative aspect-video bg-white rounded-lg border-2 border-slate-200 overflow-hidden shadow-inner">
                    <div className="absolute inset-0 grid grid-cols-2 grid-rows-2">
                      <div className="bg-orange-50/30 border-r border-b border-slate-100 flex items-start p-4"><span className="text-[10px] font-black text-orange-200 uppercase tracking-widest">Protect / Fix</span></div>
                      <div className="bg-indigo-50/30 border-b border-slate-100 flex items-start justify-end p-4"><span className="text-[10px] font-black text-indigo-200 uppercase tracking-widest">Invest</span></div>
                      <div className="bg-rose-50/30 border-r border-slate-100 flex items-end p-4"><span className="text-[10px] font-black text-rose-200 uppercase tracking-widest">Exit</span></div>
                      <div className="bg-emerald-50/30 flex items-end justify-end p-4"><span className="text-[10px] font-black text-emerald-200 uppercase tracking-widest">Harvest</span></div>
                    </div>
                    <div className="absolute left-1/2 top-0 bottom-0 w-px bg-slate-300 z-0"></div>
                    <div className="absolute top-1/2 left-0 right-0 h-px bg-slate-300 z-0"></div>

                    {customers.map(c => {
                      const pos = calculatePosition(c);
                      const action = getAction(pos.x, pos.y);
                      const bubbleSize = Math.max(40, Math.min(100, ((Number(c.revenue) || 0) / (totalRev || 1)) * 400));
                      
                      return (
                        <div 
                          key={c.id} 
                          className={`absolute rounded-full shadow-xl flex items-center justify-center cursor-pointer transition-all hover:scale-125 hover:z-50 group border-2 border-white ring-4 ${action.ring} ${action.color}`} 
                          style={{ 
                            left: `${((pos.x - 1) / 4) * 100}%`, 
                            bottom: `${((pos.y - 1) / 4) * 100}%`, 
                            width: `${bubbleSize}px`, 
                            height: `${bubbleSize}px`, 
                            transform: 'translate(-50%, 50%)' 
                          }}
                        >
                          <div className="absolute invisible group-hover:visible bg-slate-900 text-white p-3 rounded-xl text-[10px] -top-20 z-[60] shadow-2xl min-w-[140px] border border-slate-700 animate-in fade-in zoom-in duration-200">
                            <div className="font-black border-b border-slate-700 pb-1 mb-1 uppercase tracking-tighter text-indigo-400">{c.name}</div>
                            <div className="flex justify-between"><span>Revenue:</span> <span className="font-bold">${c.revenue}M</span></div>
                            <div className="flex justify-between"><span>Action:</span> <span className="font-bold">{action.label}</span></div>
                            <div className="flex justify-between"><span>Score:</span> <span>{pos.x.toFixed(1)}X, {pos.y.toFixed(1)}Y</span></div>
                          </div>
                          <span className="text-[10px] font-black text-white px-2 text-center leading-tight drop-shadow-md">
                            {bubbleSize > 60 ? c.name : c.name.split(' ').map(w => w[0]).join('')}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          )}

          {activeTab === 'customers' && (
            <div className="space-y-6">
              <div className="flex justify-between items-center">
                <h2 className="text-2xl font-bold">BD3 Client Portfolio</h2>
                <div className="flex gap-2">
                  <button onClick={() => setShowCheatSheet(true)} className="bg-white border-2 border-indigo-100 text-indigo-600 px-4 py-2 rounded-lg font-bold flex items-center gap-2 hover:bg-indigo-50 transition"><BookOpen size={18}/> Scoring Reference</button>
                  <button onClick={() => {
                    const newCust = { id: Date.now().toString(), name: 'New Client', revenue: 10, yScores: yCriteria.reduce((acc, c) => ({ ...acc, [c.id]: 3 }), {}), xScores: xCriteria.reduce((acc, c) => ({ ...acc, [c.id]: 3 }), {}) };
                    setCustomers([...customers, newCust]);
                    setEditingId(newCust.id);
                  }} className="bg-indigo-600 text-white px-4 py-2 rounded-lg font-bold flex items-center gap-2 shadow-lg hover:bg-indigo-700 transition"><Plus size={18}/> New Account</button>
                </div>
              </div>
              <div className="grid grid-cols-1 gap-6">
                {customers.map(cust => (
                  <div key={cust.id} className="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all group">
                    <div className="p-5 bg-slate-50/80 border-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                      <div className="flex-1 flex items-center gap-4 w-full sm:w-auto">
                        <div className="hidden sm:flex w-10 h-10 bg-white border border-slate-200 rounded-xl items-center justify-center text-slate-400 group-hover:text-indigo-500 transition">
                          <UserCircle size={24}/>
                        </div>
                        <div className="flex-1 sm:max-w-md">
                          {editingId === cust.id ? (
                            <input 
                              className="w-full font-bold text-lg border-2 border-indigo-200 rounded-lg px-3 py-1 bg-white focus:ring-4 focus:ring-indigo-100 outline-none" 
                              value={cust.name} 
                              onChange={e => setCustomers(customers.map(c => c.id === cust.id ? {...c, name: e.target.value} : c))} 
                              placeholder="Enter client name..."
                              autoFocus
                            />
                          ) : (
                            <h4 className="font-bold text-xl text-slate-800 tracking-tight">{cust.name}</h4>
                          )}
                        </div>
                        <div className="flex items-center gap-2 text-sm bg-indigo-600 text-white px-4 py-1.5 rounded-full shadow-sm border border-indigo-700">
                          <span className="text-indigo-200 font-bold text-[10px] uppercase">Rev:</span>
                          <div className="flex items-center">
                            <span className="mr-1">$</span>
                            <input 
                              type="number" 
                              className="w-16 font-black bg-transparent border-none p-0 focus:ring-0 text-white text-base leading-none" 
                              value={cust.revenue} 
                              onChange={e => handleRevenueChange(cust.id, e.target.value)} 
                            />
                            <span className="ml-1">M</span>
                          </div>
                        </div>
                      </div>
                      <div className="flex gap-2 self-end sm:self-auto">
                        <button 
                          onClick={() => setEditingId(editingId === cust.id ? null : cust.id)} 
                          className={`p-2.5 rounded-xl transition-all ${editingId === cust.id ? 'bg-indigo-600 text-white shadow-lg' : 'bg-white border text-slate-400 hover:text-indigo-600 hover:border-indigo-200'}`}
                          title={editingId === cust.id ? "Save Changes" : "Edit Name"}
                        >
                          {editingId === cust.id ? <CheckCircle2 size={18}/> : <Edit2 size={18}/>}
                        </button>
                        <button onClick={() => setCustomers(customers.filter(c => c.id !== cust.id))} className="p-2.5 bg-white border text-slate-400 hover:text-rose-600 hover:border-rose-200 rounded-xl transition-all" title="Remove Client">
                          <Trash2 size={18}/>
                        </button>
                      </div>
                    </div>
                    
                    <div className="p-6 grid grid-cols-1 md:grid-cols-2 gap-10">
                      {['y', 'x'].map(axis => (
                        <div key={axis} className="space-y-4">
                          <h5 className="text-[11px] font-black text-slate-400 uppercase tracking-[0.15em] mb-4 flex items-center gap-2 pb-2 border-b border-slate-100">
                            {axis === 'y' ? <TrendingUp size={14} className="text-indigo-500"/> : <ShieldCheck size={14} className="text-emerald-500"/>}
                            {axis === 'y' ? 'Customer Attractiveness' : 'Our Competitive Strength'}
                          </h5>
                          <div className="space-y-3">
                            {(axis === 'y' ? yCriteria : xCriteria).map(crit => (
                              <div key={crit.id} className="flex justify-between items-center group/row">
                                <span className="text-sm text-slate-600 group-hover/row:text-slate-900 transition-colors">{crit.name}</span>
                                <div className="flex items-center gap-2">
                                   <div className="flex gap-1">
                                     {[1,2,3,4,5].map(v => (
                                       <button
                                         key={v}
                                         onClick={() => setCustomers(customers.map(c => c.id === cust.id ? { ...c, [`${axis}Scores`]: { ...c[`${axis}Scores`], [crit.id]: v } } : c))}
                                         className={`w-7 h-7 rounded-lg text-[10px] font-bold transition-all border ${
                                           cust[`${axis}Scores`][crit.id] === v 
                                           ? (axis === 'y' ? 'bg-indigo-600 border-indigo-700 text-white scale-110 shadow-md' : 'bg-emerald-600 border-emerald-700 text-white scale-110 shadow-md')
                                           : 'bg-white border-slate-200 text-slate-400 hover:bg-slate-50'
                                         }`}
                                       >
                                         {v}
                                       </button>
                                     ))}
                                   </div>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {activeTab === 'config' && (
            <div className="space-y-8">
              <div className="flex justify-between items-center">
                <h2 className="text-2xl font-bold text-slate-800">Scoring Logic & Weights</h2>
                <div className="px-4 py-2 bg-indigo-50 border border-indigo-100 rounded-lg text-[10px] font-bold text-indigo-700 uppercase tracking-widest">Global Framework</div>
              </div>
              <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
                {['y', 'x'].map(axis => (
                  <div key={axis} className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <div className="flex items-center gap-3 mb-6 border-b border-slate-100 pb-4">
                      {axis === 'y' ? <TrendingUp className="text-indigo-500"/> : <ShieldCheck className="text-emerald-500"/>}
                      <div>
                        <h3 className="text-lg font-bold text-slate-800 uppercase tracking-tight">
                          {axis === 'y' ? 'Customer Attractiveness' : 'Our Competitive Strength'}
                        </h3>
                        <p className="text-[10px] text-slate-400 uppercase font-black tracking-wider">
                          {axis === 'y' ? 'Y-Axis Dimension' : 'X-Axis Dimension'}
                        </p>
                      </div>
                    </div>
                    <div className="space-y-4">
                      {(axis === 'y' ? yCriteria : xCriteria).map(crit => (
                        <div key={crit.id} className="flex items-center gap-4 p-4 bg-slate-50/50 hover:bg-slate-50 border border-transparent hover:border-slate-200 rounded-xl transition-all group">
                          <span className="flex-1 text-sm font-semibold text-slate-700 group-hover:text-slate-900 transition-colors">{crit.name}</span>
                          <div className="flex items-center gap-2">
                            <input 
                              type="number" 
                              value={crit.weight} 
                              onChange={e => { 
                                const val = e.target.value === '' ? '' : Number(e.target.value); 
                                (axis === 'y' ? setYCriteria : setXCriteria)((axis === 'y' ? yCriteria : xCriteria).map(c => c.id === crit.id ? {...c, weight: val} : c)); 
                              }} 
                              className="w-16 px-2 py-1.5 border border-slate-200 rounded-lg text-right text-sm font-black text-indigo-600 outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" 
                            />
                            <span className="text-xs font-bold text-slate-400">%</span>
                          </div>
                        </div>
                      ))}
                      <div className="mt-6 pt-4 border-t border-slate-100 flex justify-between items-center px-4">
                        <span className="text-xs font-bold text-slate-400 uppercase tracking-widest">Total Weight:</span>
                        <span className={`text-sm font-black ${(axis === 'y' ? yCriteria : xCriteria).reduce((s, c) => s + (Number(c.weight) || 0), 0) === 100 ? 'text-emerald-600' : 'text-rose-600'}`}>
                          {(axis === 'y' ? yCriteria : xCriteria).reduce((s, c) => s + (Number(c.weight) || 0), 0)}%
                        </span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </main>
    </div>
  );
}
